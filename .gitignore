# --- Python (на основе шаблона github/gitignore Python.gitignore) ---
__pycache__/
*.py[cod]
*$py.class
*.so

# Артефакты сборки и дистрибутивы
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# Тесты и покрытие
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# Окружение и секреты
.env
.env.*
!.env.example
.venv/
venv/
env/

# IDE и ОС
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Данные и результаты экспериментов (хранятся вне репозитория)
data/raw/
data/processed/
results/
*.npy
*.npz
calibration_cache/
